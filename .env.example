# Copy to .env and fill in values for local development.

# Rails
SECRET_KEY_BASE=
DATABASE_URL=
APP_HOST=localhost:3000

# QuickBooks OAuth — Intuit **app** credentials (shared by all orgs on this host)
# Per-org company/realm ID, environment, and tokens live in `quickbooks_tokens` — see OPERATIONS_PLATFORM_PLAN §19
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=http://localhost:3000/oauth/callback

# Production Intuit app (when org integration environment = production)
QB_CLIENT_ID_PRO=
QB_CLIENT_SECRET_PRO=
QB_REDIRECT_URI_PRO=

# Discovery — Google Places (Legacy Text Search/Details + Places API New / v1)
GPLACES_KEY=

# Outreach SMS — Twilio credentials live in server ENV only (MVP)
# Per-org from number + active flag: Settings → Outreach → Text Messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# LifeSpring website contact form → Foundation SMS opt-in webhook
# POST /webhooks/lifespring/contact_form_opt_in (Bearer token)
LIFESPRING_CONTACT_FORM_WEBHOOK_TOKEN=
LIFESPRING_CONTACT_FORM_ORG_SLUG=
LIFESPRING_OPT_IN_ADMIN_PHONE=
# Optional override for inbound HELP/INFO auto-reply (default is built-in copy)
# LIFESPRING_SMS_HELP_REPLY=

# Deprecated after §19 — realm_id stored per org in DB
# QB_COMPANY_ID_SANDBOX=
# QB_COMPANY_ID=
