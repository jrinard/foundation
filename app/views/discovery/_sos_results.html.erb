<% if rows.blank? %>
  <p class="discovery-results-empty theme-text">
    <% if total_before_filter.to_i.positive? %>
      No businesses in <strong><%= city_filter %></strong> (<%= total_before_filter %> without filter).
    <% else %>
      No businesses returned for this search.
    <% end %>
  </p>
<% else %>
  <p class="discovery-results-count theme-text">
    <%= pluralize(rows.size, "business") %> in <strong><%= city_filter %></strong>
    <% if total_before_filter.to_i > rows.size %>
      <span class="discovery-results-filter-note">(<%= total_before_filter %> without filter)</span>
    <% end %>
  </p>

  <div class="discovery-results-table-wrap">
    <table class="discovery-results-table">
      <thead>
        <tr>
          <% Discovery::Sources::WaSos::CsvParser::RESULTS_UI_DISPLAY_COLUMNS.each do |column| %>
            <% office_class = column == "Office Address" ? " discovery-results-office-address" : "" %>
            <% phone_class = column == Discovery::Sources::WaSos::CsvParser::UI_PHONE_COLUMN ? " discovery-results-phone-col" : "" %>
            <th scope="col" class="theme-text<%= office_class %><%= phone_class %>"><%= Discovery::Sources::WaSos::CsvParser.ui_column_label(column) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr class="discovery-results-row">
            <% Discovery::Sources::WaSos::CsvParser::RESULTS_UI_DISPLAY_COLUMNS.each do |column| %>
              <% if column == Discovery::Sources::WaSos::CsvParser::UI_PHONE_COLUMN %>
                <td class="theme-text discovery-results-phone-cell">
                  <% phone = Discovery::Sources::WaSos::CsvParser.row_phone(row) %>
                  <% if phone.present? %>
                    <span class="discovery-results-phone-yes" title="<%= phone %>">Yes</span>
                  <% else %>
                    —
                  <% end %>
                </td>
              <% else %>
                <% office_class = column == "Office Address" ? " discovery-results-office-address" : "" %>
                <td class="theme-text<%= office_class %>"><%= row[column].presence || "—" %></td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
