<%# locals: business %>
<%
  business = local_assigns[:business]
  has_website = business.present? && business.website.to_s.strip.present?
  show_mountain_gems = business.present? && business.organization.discovery_data_axel_available?
%>
<%= foundation_modal modal_id: "discoveryAdvancedDataMenu", title: Discovery::GemSources.refine_label, size: :sm,
      dialog_class: "discovery-advanced-data-menu-modal" do %>
  <p class="theme-text discovery-advanced-data-menu-note">
    Choose an alternate enrichment source.
  </p>

  <div class="discovery-advanced-data-menu-options">
    <% if show_mountain_gems %>
      <button type="button"
              class="btn discovery-advanced-data-menu-option theme-text"
              data-advanced-data-option="axel"
              data-action="click->discovery-business-show#runAdvancedDataMenuOption">
        <span class="discovery-advanced-data-menu-option-label"><%= Discovery::GemSources.refine_mountain_gems_label %></span>
        <span class="discovery-advanced-data-menu-option-note">
          Search local Mountain Gems data — phone, address &amp; contact fields
        </span>
      </button>
    <% end %>

    <button type="button"
            class="btn discovery-advanced-data-menu-option theme-text"
            data-advanced-data-option="legacy"
            data-action="click->discovery-business-show#runAdvancedDataMenuOption">
      <span class="discovery-advanced-data-menu-option-label"><%= Discovery::GemSources.refine_legacy_label %></span>
      <span class="discovery-advanced-data-menu-option-note"><%= Discovery::GemSources.refine_legacy_subtext %></span>
    </button>

    <button type="button"
            class="btn discovery-advanced-data-menu-option theme-text"
            data-advanced-data-option="lni"
            data-action="click->discovery-business-show#runAdvancedDataMenuOption">
      <span class="discovery-advanced-data-menu-option-label"><%= Discovery::GemSources.refine_forge_gems_label %></span>
      <span class="discovery-advanced-data-menu-option-note"><%= Discovery::GemSources.refine_forge_gems_subtext %></span>
    </button>

    <button type="button"
            class="btn discovery-advanced-data-menu-option theme-text<%= " is-disabled" unless has_website %>"
            data-advanced-data-option="website"
            data-action="click->discovery-business-show#runAdvancedDataMenuOption"
            <%= "disabled" unless has_website %>>
      <span class="discovery-advanced-data-menu-option-label">Website</span>
      <span class="discovery-advanced-data-menu-option-note discovery-advanced-data-menu-option-note-with-icons">
        <% if has_website %>
          Scan site for phone, email &amp; <%= render "shared/social_brand_icons", size: 15 %>
        <% else %>
          Add a website on this capture to enable
        <% end %>
      </span>
    </button>
  </div>

  <%= foundation_modal_footer do %>
    <%= foundation_modal_close_button "Cancel", class: "discovery-page-btn" %>
  <% end %>
<% end %>
