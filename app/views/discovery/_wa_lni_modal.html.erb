<%= foundation_modal modal_id: "discoveryWaLni", title: "Labor & Industry", size: :lg,
      dialog_class: "discovery-lni-modal" do %>
  <p class="theme-text discovery-modal-note discovery-lni-modal-status"
     data-discovery-business-show-target="lniModalStatus"></p>

  <div data-discovery-business-show-target="lniModalMatches"></div>
  <div data-discovery-business-show-target="lniModalDetails" hidden></div>

  <%= foundation_modal_footer do %>
    <button type="button"
            class="btn btn-dark discovery-page-btn theme-text"
            hidden
            data-discovery-business-show-target="lniModalBackButton"
            data-action="click->discovery-business-show#backToLniMatches">
      ← Matches
    </button>

    <button type="button"
            class="btn btn-warning discovery-page-btn discovery-lni-confirm-btn theme-text"
            hidden
            data-discovery-business-show-target="lniModalConfirmButton"
            data-action="click->discovery-business-show#confirmEnrichmentSave">
      Confirm &amp; save
    </button>

    <%= foundation_modal_close_button "Cancel", class: "discovery-page-btn" %>
  <% end %>
<% end %>
