<%= form_with model: plan, url: plan.persisted? ? outreach_plan_path(plan) : outreach_plans_path, local: true, class: "theme-text" do |f| %>
  <% if plan.errors.any? %>
    <div class="alert alert-danger"><%= plan.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, class: "h3-grey" %>
    <%= f.text_field :name, class: "form-control theme-field", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :service_tag, "Service tag (optional)", class: "h3-grey" %>
    <%= f.text_field :service_tag, class: "form-control theme-field", placeholder: "Website, SMS, Email…" %>
  </div>

  <div class="form-group">
    <%= f.label :description, class: "h3-grey" %>
    <%= f.text_area :description, rows: 3, class: "form-control theme-field" %>
  </div>

  <div class="form-group">
    <label class="org-admin-check">
      <%= f.check_box :active %>
      Active
    </label>
  </div>

  <div class="outreach-form-actions">
    <%= f.submit plan.persisted? ? "Save plan" : "Create plan", class: "btn btn-warning discovery-split-btn-main" %>
    <%= link_to "Cancel", plan.persisted? ? outreach_plan_path(plan) : outreach_plans_path, class: "btn btn-default theme-text" %>
  </div>
<% end %>
