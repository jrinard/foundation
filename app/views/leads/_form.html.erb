<div class="col-sm-4">
  <div class="black-card-lead-form">
    <div class="center">
      <br>
      <div id="searchModal" data-controller="search">
        <form data-action="submit->search#search">
          <input type="text" placeholder="Search" class="form-control form-control-large" data-target="search.formInput" /><br>
          <button type="submit" class="btn btn-dark" style="display: none;">Search for Customer</button>
        </form>
        <br>
        <div data-target="search.results"></div>
      </div>
    </div>
  </div>
</div>


<br><br><br>

<div class="actions field">
