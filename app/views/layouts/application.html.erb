                <% if leads_enabled? %>
                <li class="<%= 'active_bg2' if current_page?(customers_path) %>"><%= link_to "Leads #{@count_lead.size}", customers_path(user_id: current_user.id), :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
                <% end %>
                <% if potentials_enabled? %>
                <li class="<%= 'active_bg2' if current_page?(potentials_path) %>"><%= link_to "Potentials #{@count_potential.size}", potentials_path(user_id: current_user.id), :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
                <% end %>
                <% if current_clients_enabled? %>
                <li class="<%= 'active_bg2' if controller_name == 'home' %>"><%= link_to "Current Clients #{@count_current.size}", home_index_path, :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
                <% end %>
                <% if archived_enabled? %>
                <li class="<%= 'active_bg2' if current_page?(archived_index_path) %>"><%= link_to "Archived #{@count_archived.size}", archived_index_path, :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
