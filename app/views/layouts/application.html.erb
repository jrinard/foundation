
<html>
  <head>
    <title>Foundation</title>
    <meta charset="UTF-8">
    <meta name=viewport content="width=device-width, initial-scale=1">
    <script>
      (function () {
        try {
          var storedTheme = localStorage.getItem("foundation-theme");
          if (storedTheme === "dark") {
            document.documentElement.style.backgroundColor = "#000";
          }
        } catch (e) {}
      })();
    </script>
    <link href="https://fonts.googleapis.com/css?family=Bangers|Heebo|Passion+One|Open+Sans" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.min.js"></script>
    <%= javascript_include_tag "https://www.gstatic.com/charts/loader.js" %>

    <%= csrf_meta_tags %>
    <%#= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%#= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <%#= stylesheet_link_tag 'application', media: 'all', 'data-turbo-track': 'reload' %>
    
    <%#= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%#= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application.css", "data-turbo-track": "reload" %>  
    <%= javascript_include_tag "application.js", "data-turbo-track": "reload" %>
  </head>
  <%#= body_class %>
  <%# <body id="app-theme-body" data-controller="theme"> %>
  <body id="app-theme-body" data-controller="theme">
  <script>
    (function () {
      try {
        var storedTheme = localStorage.getItem("foundation-theme");
        if (storedTheme === "dark") {
          document.body.setAttribute("data-dark", "true");
        } else {
          document.body.removeAttribute("data-dark");
        }
      } catch (e) {}
    })();
  </script>
  <!--   <body class="<%#= body_class %>">-->

    <%# <div id="app-theme" data-controller="theme"> %>
    <div id="app">
  <%= turbo_frame_tag "modal" %>

  <div class="">  
  <%# was col-sm-12  %>

    <!-- Desktop View -->
    <div class="mobile-hide">

      <div id="mySidenav" class="sidenav center">
          <div class="greybar greybar-org-header">
          <% if current_user %>
            <%= render "shared/organization_context" %>
          <% end %>
          </div>

          <div class="flash-desktop">
            <div class="flash-grey" id="flash"><%= flash[:notice] %><%= flash[:errors] %></div>
          </div>
          <div class="flash-mobile">
            <div class="flash-grey" id="flash-m"><%= flash[:notice] %><%= flash[:errors] %></div>
          </div>

        <nav class="nav">

        <% if leads_enabled? %>
        <%= link_to 'New Lead', new_lead_path, class: "btn btn-xs left-align btn-lead btn-lead-hover", data: { turbo_frame: "modal" } %>
        <% end %>
        <% if potentials_enabled? %>
        <li class="<%= 'active_bg' if current_page?(potentials_path) %>"><%= link_to "Potentials #{@count_potential.size}", potentials_path(user_id: current_user.id), class: 'notWorking' %></li>
        <% end %>
        <% if leads_enabled? %>
        <li class="<%= 'active_bg' if current_page?(customers_path) %>"><%= link_to "Leads #{@count_lead.size}", customers_path(user_id: current_user.id), :class => 'notWorking' %></li>
        <% end %>
        <% if current_clients_enabled? %>
        <li class="<%= 'active_bg' if controller_name == 'home' %>"><%= link_to "Current Clients #{@count_current.size}", home_index_path, :class => 'notWorking' %></li>
        <% end %>
        <% if archived_enabled? %>
        <li class="<%= 'active_bg' if current_page?(archived_index_path) %>"><%= link_to "Archived ", archived_index_path, :class => 'notWorking' %></li>
        <% end %>
        <% if activity_enabled? %>
        <li class="<%= 'active_bg' if current_page?(activity_index_path) %>"><%= link_to "Activity", activity_index_path, :class => 'notWorking' %></li>
        <% end %>
        <li class="<%= 'active_bg' if current_page?(settings_path) %>"><%= link_to "Settings", settings_path, :class => 'notWorking' %></li>
        <br>

        <% if current_user.admin? || current_user.superadmin? %>
          <li class="<%= 'active_bg' if current_page?(users_path) %>"><%= link_to "Users", users_path, :class => 'notWorking' %></li>
        <% end %>
        <% if current_user.superadmin? %>
          <li class="<%= 'active_bg' if controller_name == 'organizations' %>"><%= link_to "Organizations", organizations_path, class: "notWorking" %></li>
        <% end %>
        <br>

        <%# <li class="h5-grey shift-right4">QUICK LINKS</li> %>

        <li>  <%#= link_to "Dropbox", "https://www.dropbox.com", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "GlooMaps", "https://www.gloomaps.com/", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "Cloudways", "https://platform.cloudways.com/login", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "Manage WP", "https://orion.managewp.com/login", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "Apex", "https://theme.co/apex/login", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "Cloudflare", "https://dash.cloudflare.com/login", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "GoDaddy", "https://www.godaddy.com/", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <li>  <%#= link_to "Siteground", "https://ua.siteground.com/login.htm", target: "_blank", :class => " btn-long btn-text-md" %></li>
        <br>

        <!-- Desktop Version -->
          <div class="login-desktop sidenav-footer center mb-30" data-id="login-desktop">
            <% if current_user %>
            <%= render "shared/nav_user_account" %>
            <div class="nav-footer-actions">
              <%= render "shared/theme_toggle" %>
              <%= button_to "Log-out", destroy_user_session_path, method: :delete, class: "btn-dark nav-footer-action-btn" %>
            </div>
            <% end %>
          </div>

        <span class="stick-bottom-version h5 grey">Version 2.0 <%= ENV["HEROKU_RELEASE_VERSION"] %></span>
        <br>
        </div>
    </div>
  </div>




 <!-- Mobile Version -->
          <div class="login-mobile center">
            <div class="greybar header-container-mobile">
              <% if current_user %>
                <div class="mobile-header-main">
                  <%= render "shared/organization_context" %>
                </div>
                <div class="mobile-header-actions">
                  <%= link_to image_tag("threedots.png", class: "menu-icon-size3 mobile-header-meatball"), edit_user_registration_path, aria: { label: "Account settings" } %>
                  <%= button_to "Log-out", destroy_user_session_path, method: :delete, class: "btn btn-dark mobile-header-logout-btn" %>
                </div>
              <% end %>
            </div>
          </div>

        <!-- NEW DROPDOWN SHOWS IN MOBILE -->
        <div class="row desktop-hide">
          <div class="col-md-12 options-dropdown text-center dropdown-background">
            <div class="dropdown toggle_contact dropdown-higher">
              <button class="mobile-home-btn-dark-long dropdown-toggle dropdown-custom-size" type="button" id="dropdownContacts" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="h3-white mobile-icon-ham">☰</span>
              </button>
              <ul class="dropdown-menu-mobile edit_form_contact hide" aria-labelledby="dropdownContacts">
                <% if leads_enabled? %>
                <li><%= link_to 'New Lead', new_lead_path, class: "btn btn-long-home-nav btn-text-mobile-nav", data: { turbo_frame: "modal" } %></li>
