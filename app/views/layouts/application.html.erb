                <% if activity_enabled? %>
                <li class="<%= 'active_bg2' if current_page?(activity_index_path) %>"><%= link_to "Activity", activity_index_path, :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
                <% end %>
                <li class="<%= 'active_bg2' if current_page?(edit_user_registration_path) %>"><%= link_to 'My Account', edit_user_registration_path, :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>

                <% if current_user.admin? || current_user.superadmin? %>
                  <li class="<%= 'active_bg2' if current_page?(users_path) %>"><%= link_to 'Users', users_path, :class => 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
                <% end %>
                <% if current_user.superadmin? %>
                  <li class="<%= 'active_bg2' if controller_name == 'organizations' %>"><%= link_to 'Organizations', organizations_path, class: 'btn btn-long-home-nav btn-text-mobile-nav' %></li>
                <% end %>

                <li class="mobile-nav-theme-item desktop-hide">
                  <%= render "shared/theme_toggle" %>
                </li>

                  <%# <li>  %>
                  <%#= button_to 'Log-out', destroy_user_session_path, :method => :delete, :style => 'padding: 5px; margin-left: 175px;', :class => "btn-text-mobile-nav btn-dark" %>
                  <%# </li> %>
              
              </ul>
            </div>
          </div>
        </div>


        <div class="col-xs-12 app-mobile-window-limit">

         <%# Adding turbo-frame id="modal" herecauses customer details to never load %>
         <%#= turbo_frame_tag "modal" %>
          <%= yield %>
          
        </div>

      </div>

    </div>
 </div>  <%#= dark theme end %>

  </body>
</html>
