<div class="login-page-title-row">
  <h2 class="h2-white login-page-title">Forgot your password?</h2>
</div>

<div class="form white-well login-form-panel">
  <% if flash[:alert] %>
    <div class="alert alert-danger theme-text-error">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="alert alert-info login-page-notice">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <p class="login-page-help">Enter your email and we&rsquo;ll send reset instructions.</p>

  <%= form_for(resource, as: resource_name, url: user_password_path, html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.email_field :email, autofocus: true, class: "form-control input-lg", placeholder: "Email" %>
    </div>

    <div class="actions">
      <%= f.submit "Send reset password info", class: "btn btn-lg btn-warning btn-long btn-big" %>
    </div>
  <% end %>
</div>

<div class="login-override center login-page-footer">
  <%= link_to "Back to sign in", new_user_session_path, class: "login-page-forgot-link" %>
</div>
