      <%= link_to "C", { sort_by: "letter", params: { l: "C" } }, class: "btn btn-xs" %><br>
      <%= link_to "D", { sort_by: "letter", params: { l: "D" } }, class: "btn btn-xs" %><br>
      <%= link_to "E", { sort_by: "letter", params: { l: "E" } }, class: "btn btn-xs" %><br>
      <%= link_to "F", { sort_by: "letter", params: { l: "F" } }, class: "btn btn-xs" %><br>
      <%= link_to "G", { sort_by: "letter", params: { l: "G" } }, class: "btn btn-xs" %><br>
      <%= link_to "H", { sort_by: "letter", params: { l: "H" } }, class: "btn btn-xs" %><br>
      <%= link_to "I", { sort_by: "letter", params: { l: "I" } }, class: "btn btn-xs" %><br>
      <%= link_to "J", { sort_by: "letter", params: { l: "J" } }, class: "btn btn-xs" %><br>
      <%= link_to "K", { sort_by: "letter", params: { l: "K" } }, class: "btn btn-xs" %><br>
      <%= link_to "L", { sort_by: "letter", params: { l: "L" } }, class: "btn btn-xs" %><br>
      <%= link_to "M", { sort_by: "letter", params: { l: "M" } }, class: "btn btn-xs" %><br>
      <%= link_to "N", { sort_by: "letter", params: { l: "N" } }, class: "btn btn-xs" %><br>
      <%= link_to "O", { sort_by: "letter", params: { l: "O" } }, class: "btn btn-xs" %><br>
      <%= link_to "P", { sort_by: "letter", params: { l: "P" } }, class: "btn btn-xs" %><br>
      <%= link_to "Q", { sort_by: "letter", params: { l: "Q" } }, class: "btn btn-xs" %><br>
      <%= link_to "R", { sort_by: "letter", params: { l: "R" } }, class: "btn btn-xs" %><br>
