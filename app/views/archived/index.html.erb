      <%= link_to "V", { sort_by: "letter", params: { l: "V" } }, class: "btn btn-xs" %><br>
      <%= link_to "W", { sort_by: "letter", params: { l: "W" } }, class: "btn btn-xs" %><br>
      <%= link_to "X", { sort_by: "letter", params: { l: "X" } }, class: "btn btn-xs" %><br>
      <%= link_to "Y", { sort_by: "letter", params: { l: "Y" } }, class: "btn btn-xs" %><br>
      <%= link_to "Z", { sort_by: "letter", params: { l: "Z" } }, class: "btn btn-xs" %><br>
    </div>
  </div>

  <div class="col-sm-4 shift-down30">
    <div class="white-card theme-card">
      <h2 class="pull-left theme-text">Archived Clients</h2>

      <div class="center">
        <% if @archived_customers.any? %>
          <% @archived_customers.each do |customer| %>
            <span id="cust_<%= customer.id %>">
              <%= link_to customer.name,
                    { params: { id: customer.id, l: customer.letter } },
                    class: "h3-black customer-card btn btn-md btn-long" %><br>
            </span>
          <% end %>
        <% else %>
          <br><br><br>
          <h3 class="h4-black theme-text">No Customers Archived</h3>
        <% end %>
      </div>
    </div>
  </div>

  <%= render "archived/3-client-information" %>
</div>
