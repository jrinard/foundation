<div class="flex-box center">
  
  <div class="desk-marg">

  <% if current_user.admin? || current_user.superadmin? %>
  <div class="white-box-user theme-card-simple">
    <div class="back">
      <%= link_to 'Back', users_path, :class => "btn btn-warning btn-wide pull-right round shift-left2" %>
    </div><br>

    <h3 class="theme-text"><%= @user.email %></h3><hr>
    <table>
      <tr class="mobile-hide">
        <td class="td-yellow">Name</td>
        <td class="td-yellow">EMAIL</td>
        <td class="td-yellow">ACCOUNT CREATED</td>
        <td class="td-yellow">LAST SIGN IN</td>
        <td class="td-yellow">SIGN IN COUNT</td>
      </tr>
    </table>
    <table>
      <tr>
        <td>
          <span class="td-yellow2 desktop-hide theme-text">NAME
          </span>
          <span class="mobile-pull-right theme-text"><%= @user.name %></span>
        </td>
        <td>
          <span class="td-yellow2 desktop-hide theme-text">EMAIL
          </span>
          <span class="mobile-pull-right theme-text"><%= @user.email %></span>
        </td>
        <td>
          <span class="td-yellow2 desktop-hide theme-text">CREATED AT
          </span>
          <span class="theme-text mobile-pull-right"><%= @user.created_at.strftime("%b %d, %Y") %></td>
        </span>
        <% if @user.last_sign_in_at.present? %>
        <td>
          <span class="td-yellow2 desktop-hide">LAST SIGN IN</span>
          <span class="theme-text"><%= @user.last_sign_in_at.strftime("%b %d %Y, %I:%M %P") %>
         </span>
        </td> 
      <% else %>
       <td>
      <span class="td-yellow2 desktop-hide theme-text">LAST SIGN IN</span>
        <span class="theme-text mobile-pull-right">0</span>
                </td> 
        <% end %>
        <td>
          <span class="td-yellow2 desktop-hide theme-text">SIGN IN COUNT</span>
          <span class="theme-text mobile-pull-right">
          <%= @user.sign_in_count %>
          </span>
          </td>
      </tr>
    </table>
    <table>
      <tr>
        <td>
        <span class="theme-text">
          ROLE : </span>
          <% if @user.role === "user"  %>
            <%= link_to 'User', { :user_man => "man"}, :class => "btn btn-sm  btn-default round theme-text mobile-pull-right" %>
          <% else %>
            <%= link_to "Account Manager", { :user_user => "user"}, :class => "btn btn-sm btn-default round theme-text mobile-pull-right " %>
          <% end %>
        </td>
      </tr>
    </table>
    <br>
    <div class="center">
      <td>
        <% if can?(:edit, User) %>
            <span class="mobile-pull-right"> <%= link_to 'Edit', edit_user_path(@user.id), class: "btn btn-xs btn-default theme-text", data: { turbo_frame: "modal" } %></span>
        <% end %>
        <%#= link_to_if(can?(:edit, @user), image_tag("icon-edit.png", :class => "user-icon-size"), edit_user_path(@user.id)) {} %>
      </td>
      
        <% if current_user.admin? || current_user.superadmin? %>
            <span class="mobile-pull-right"><%= link_to 'Delete', @user, class: "btn btn-default theme-text", id: "delete-test", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this customer?" }, remote: true %>
         <% end %>
         
      <%#= link_to_if(can?(:delete, @user), image_tag("icon-delete.png", :class => "user-icon-size"), user_path(@user), :data => {:confirm => "Are you sure you want to delete the user and everything attached?",:method => "delete"}) {} %>
    </div>

    <% end %>
    <!-- admin end -->
  </div>
</div>
</div>
<!-- flex box end -->