<% customer = local_assigns[:customer] || @chosen_customer %>
<% return if customer.blank? %>

<span class="h3-grey theme-text">SMS status</span><br>
<div class="edit_family theme-text">
  <% if customer.sms_opt_in == true && customer.sms_opt_in_at.present? %>
    Opted in <%= customer.sms_opt_in_at.strftime("%b %d, %Y") %>
  <% elsif customer.sms_opted_out? && customer.sms_opt_out_at.present? %>
    Opted out <%= customer.sms_opt_out_at.strftime("%b %d, %Y") %>
  <% else %>
    <%= customer.sms_opt_status_label %>
  <% end %>
  <% if customer.sms_opt_out_note.present? && customer.sms_opted_out? %>
    <br><span class="theme-text outreach-muted sms-opt-audit-meta"><%= customer.sms_opt_out_note %></span>
  <% end %>
</div>
<div class="edit_f">
  <%= form_for customer do |f| %>
    <div class="input-group">
      <%= f.select :sms_opt_in,
            options_for_select([
              ["Not set", ""],
              ["Opted in", true],
              ["Opted out", false]
            ], customer.sms_opt_in),
            {},
            class: "form-control form-width theme-field" %>
      <%= f.select :sms_opt_in_source,
            sms_opt_in_source_options_for_select(customer),
            {},
            class: "form-control form-width theme-field" %>
      <%= f.text_field :sms_opt_out_source,
            placeholder: "Opt-out source",
            class: "form-control form-width theme-field" %>
      <%= f.text_field :sms_opt_out_note,
            placeholder: "Opt-out note (optional)",
            class: "form-control form-width theme-field" %>
      <%= hidden_field_tag(:subaction, customer.id) %>
      <div class="input-group-btn">
        <%= f.submit "Save", name: nil, params: { id: customer.id }, class: "btn-sm btn-warning form-width" %>
      </div>
    </div>
  <% end %>
</div><br>
