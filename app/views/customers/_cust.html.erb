<% if cust.nil? %>
  <p>Customer not found. _cust error 101</p>
<% else %>

    <div id="<%= dom_id cust %>" class="lead-card-dark">
      <div class="dark-card-content">
        <div class="center-text">
          <h3 class="customer-name-lead"><%= cust.name rescue nil %></h3>
          <div class="lead-card-meta-row">
            <% if outreach_enabled? %>
              <%= link_to customers_path(request.query_parameters.merge(id: cust.id, outreach_open: "1")),
                    class: "lead-card-outreach-btn",
                    title: "Outreach" do %>
                Outreach
              <% end %>
            <% end %>
            <span class="lead-card-manager pull-right"><%= cust.user.name rescue nil %></span>
          </div>
        </div>
        <div class="icon-buttons-lead">
          <div class="dark-edit-button-lead">
            <%= link_to edit_customer_path(cust.id), class: "lead-card-edit-btn", data: { turbo_frame: "modal" }, title: "Edit" do %>
              <span class="lead-card-edit-icon"
                    style="--lead-edit-icon: url('<%= image_path("icon-edit-black.png") %>')"
                    role="img"
                    aria-label="Edit"></span>
            <% end %>
          </div>

          <%# <div class="dark-intake-button-lead"> %>
            <%#= link_to edit_notes_note_path(cust.id), class: "", data: { turbo_frame: "modal" } do %>
              <%#= image_tag("icon-edit-white.png", alt: "Edit", class: "icon-edit tag-lead-card-btn") %>
            <%# end %>
          <%# </div> %>


          <%# if cust.intake.present? %>
            <%# <div class="dark-intake-button-lead"> %>
              <%#= link_to edit_customer_intake_path(cust.intake), class: "", data: { turbo_frame: "modal" } do %>
                <%#= image_tag("icon-list-yellow.png", alt: "Intake", class: "icon-add") %>
              <%# end %>
            <%# </div> %>
          <%# else %>
            <%# <div class="dark-intake-button-lead"> %>
              <%#= link_to({ :add_intakes => "add_intakes", :id => cust.id }, class: "") do %>
                <%#= image_tag("icon-list-white.png", alt: "Add Intake", class: "icon-edit") %>
              <%# end %>
            <%# </div> %>
          <%# end %>

