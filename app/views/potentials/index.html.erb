    <!-- Search by customer -->
    <div class="col-sm-4 shift-down30">
      <div class="theme-card mb-10">
        <div class="center">
          <%= form_tag(potentials_path, :method => "get", id: "search-form") do %>
          <div class="input-group-off">
            <%= text_field_tag :search, params[:search], placeholder: "Search Potentials", class: "form-control theme-field", required: true %>
            <div class="input-group-btn">
              <%= submit_tag "Search", :name => nil, class: "btn btn-warning round", :style => "display: none;" %>
            </div>
          </div>
        <% end %>

        <% if @searchResults %>
         <h4 class="theme-text">Results</h4>
          <% @searchResults.each do |customer| %>

            <div class="search-results center color-contact-card-search-grey">
              <!-- Limits usable link to customers that were current -->
              <%= link_to "#{customer.name} ", {:params => {:id => customer.id}},:params => {:id => customer.id}, :class => "btn btn-lg theme-text" %><br>
                <%#= link_to "#{customer.name}", {:params => {:id => customer.id, :l => customer.letter}}, :class => "h3-black customer-card btn btn-md btn-long" %>
              </div>
            <% end %>
            <% if @searchResult.nil? %>
              <% if @searchResults.empty? %>
                <%# No Current Client Found %>

              <% end %>
            <% end %>
          <% end %>


   <% if @searchResultsContacts %>
         <h4 class="theme-text">Contacts</h4>
          <% @searchResultsContacts.each do |contact| %>

            <div class="search-results center color-contact-card-search-yellow theme-text">
              <!-- Needs to point to Customer Contact Belongs too #{contact.email} #{contact.phone} #{contact.email} -->
              <span class="theme-text">
              <%= link_to "#{contact.firstname} #{contact.lastname}", {:params => {:id => contact.customer_id}},:params => {:id => contact.customer_id}, :class => "btn btn-lg btn-long-search theme-text" %><br>
               </span>
               <%= contact.customer.name %>
              </div>
            <% end %>
            <% if @searchResultsContacts.nil? %>
              <% if @searchResultsContacts.empty? %>
                <%# No Contact %>

              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

  <%# Potential Clients %>
    <div class="theme-card">
      <h2 class="pull-left theme-text">Potentials</h2>
        <span class="h2-white center pull-right"><%= link_to '+ Add New', new_customer_path, :class => " btn btn-md btn-warning center ", data: { turbo_frame: "modal" } %></span>
        <br>
        <hr>
        
<!-- FILTERS v2 -->
<div class="dropdown toggle_contact theme-text">
  <% if @chosen_filter %>
    Filtering by <%= @chosen_filter %>
    <%= link_to "Clear", potentials_path(prospects_list_params.except(:filter_by, :sort_by_manager)), class: "btn btn-xs btn-default theme-text margin-l-5" %>
  <% end %>

  <button class="btn dropdown-toggle pull-right theme-back" type="button" id="filterIconDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <%= image_tag("icon-filter.png", alt: "like", class: "nav-icon-size-dropdown  theme-icon") %>
  </button>

  <div class="dropdown-menu edit_form_contact hide" aria-labelledby="filterIconDropdown">
    <div class="card-header-yellow-off theme-text">
      <br>
      Sort By
      <br>
      <%= link_to "Newest", prospects_list_params(sort_by: "created_at desc"), class: "btn btn-md btn-default theme-text" %>
      <%= link_to "Updated Recently", prospects_list_params(sort_by: "updated_at desc"), class: "btn btn-md btn-default theme-text" %>
      <%= link_to "Name", prospects_list_params(sort_by: "name asc"), class: "btn btn-md btn-default theme-text" %>
      <%= render "shared/offering_list_filters" %>
      <br>
      Source
      <br>
      <%= link_to "Contact form", prospects_list_params(filter_by: "website_contact_form"), class: "btn btn-md btn-default theme-text" %>
      <%= link_to "Website review", prospects_list_params(filter_by: "website_review"), class: "btn btn-md btn-default theme-text" %>
      <%= link_to "Opt-in Today", prospects_list_params(filter_by: "opted_in_today"), class: "btn btn-md btn-default theme-text" %>
      <%= link_to "Opt-in Week", prospects_list_params(filter_by: "opted_in_this_week"), class: "btn btn-md btn-default theme-text" %>
      <%= link_to "All prospects", prospects_list_params.except(:filter_by), class: "btn btn-md btn-default theme-text" %>
      <div class="prospects-filter-account-manager-section">
      Account Manager
      <br>
      <%= form_tag("", method: "get") do %>
        <%= select_tag "sort_by_manager", options_for_select([["Filter by Account Manager", ""]] + @accountManagersByName.map { |manager| [manager[0], "#{manager[1]} desc"] }, params[:sort_by_manager]), class: "form-control cc-input-select-wide margin-r-20 theme-field", onchange: "this.form.submit();" %>
      <% end %>
      </div>
    </div>
  </div>
</div>

      <!-- Import Customer CSV -->
