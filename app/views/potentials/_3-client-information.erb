<%# MIDDLE SECTION %>
  <div class="col-sm-4 shift-down30 max-w-370">
    <% if !@chosen_customer.nil? %>

      <div class="white-card mb-20 theme-card theme-text">

        <!-- MiniMenu -->
    <div class="center">
         <div class="center">
              <div class="card-header-yellow-off">
                <% if params[:id] %>
                  <%# if @chosen_customer.active === false  %>
                    <%#= link_to "Move to Current", { :active => "active",:id => @chosen_customer.id }, :class => "btn btn-default" %>
                  <%# else %>
                    <%#= link_to "Move to Leads", { :inactive => "inactive",:id => @chosen_customer.id }, :class => "btn btn-default" %>
                  <%# end %>

                  <%= link_to 'Edit', edit_customer_path(@chosen_customer.id), :class => "btn btn-default theme-text", data: { turbo_frame: "modal" } %>

                  <% if @chosen_customer.onBoard != "Archive"  %>
                     <%#= link_to 'Archive Client', { :archive => "archive",:id => @chosen_customer.id }, :class => "btn btn-default theme-text",:data => {:confirm => "Archiving will move Client to the Archived pages"} %>
                  <% end %>

                  <% if current_user.admin? || current_user.superadmin? %>
                     <%# turbo with confirmation %>
                      <%= link_to 'Delete', @chosen_customer, class: "btn btn-default theme-text", id: "delete-test", data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this customer?" }, remote: true %>
                  <% end %>

                  <%# <div class="h3-grey "><br>
                     Account Manager %>
                    <%#= @chosen_customer.user.name rescue "NA" %>
                  <%# </div> %>
                  <%# <div class="h3-grey "><br> %>
                    <%# Sales Person %>
                    <%#= @chosen_customer.sales_person.present? ? User.find_by(id: @chosen_customer.sales_person)&.email : "NA" %>
                  <%# </div> %>
                <% end %>
                </div><hr>
              </div>
            </div>
        

          <h2>Client Information</h2>

          <span class="h3-grey">Company</span><br>

          <!-- Javascript form toggle -->
          <div class="edit_family-off h3-black theme-text"><%= @chosen_customer.name %></div>
          <div class="edit_f">
            <%= form_for @chosen_customer do |f| %>
            <div class="input-group">
              <%= f.text_field :name, :placeholder => 'Name', :class => 'form-control form-width' %>
              <%= hidden_field_tag(:subaction, @chosen_customer.id) %>
              <div class="input-group-btn">
                <%= f.submit "Save", :name => nil, :params => {:id => @chosen_customer.id }, class: " btn-sm btn-warning form-width" %>
              </div>
            </div>
          <% end %>
        </div><br>

        <span class="h3-grey">Domain</span><br>
        <!-- Javascript form toggle -->
        <div class="edit_family-off h3-black theme-text"><%= @chosen_customer.domain %></div>
        <div class="edit_f">
          <%= form_for @chosen_customer do |f| %>
          <div class="input-group">
            <%= f.text_field :domain, :placeholder => 'Domain', :class => 'form-control form-width' %>
            <%= hidden_field_tag(:subaction, @chosen_customer.id) %>
            <div class="input-group-btn">
              <%= f.submit "Save", :name => nil, :params => {:id => @chosen_customer.id }, class: " btn-sm btn-warning form-width" %>
            </div>
          </div>
        <% end %>
      </div><br>

      <span class="h3-grey">Phone</span><br>
      <!-- Javascript form toggle -->
      <div class="edit_family-off h3-black theme-text"><%= @chosen_customer.phone %></div>
      <div class="edit_f">
        <%= form_for @chosen_customer do |f| %>
        <div class="input-group">
          <%= f.text_field :phone, :placeholder => '208-123-4565', :class => 'form-control form-width' %>
          <%= hidden_field_tag(:subaction, @chosen_customer.id) %>
          <div class="input-group-btn">
            <%= f.submit "Save", :name => nil, :params => {:id => @chosen_customer.id }, class: " btn-sm btn-warning form-width" %>
          </div>
        </div>
      <% end %>
    </div><br>

    <%= render "customers/sms_opt_status" if outreach_enabled? %>

    <span class="h3-grey">Address</span><br>
    <!-- Javascript form toggle -->
    <div class="edit_family-off h4-black theme-text">
      <%= @chosen_customer.address %><br>
      <%= @chosen_customer.city %>
      <%= @chosen_customer.state %>
      <%= @chosen_customer.zip %>
    </div>
    <div class="edit_f">
      <%= form_for @chosen_customer do |f| %>
      <div class="input-group">
        <%= f.text_field :address, :placeholder => 'Street', :class => 'form-control form-width' %>
        <%= f.text_field :city, :placeholder => 'City', :class => 'form-control form-width' %>
        <%= f.text_field :state, :placeholder => 'State', :class => 'form-control form-width' %>
        <%= f.text_field :zip, :placeholder => 'Zip', :class => 'form-control form-width' %>
        <%= hidden_field_tag(:subaction, @chosen_customer.id) %>
        <div class="input-group-btn">
          <%= f.submit "Save", :name => nil, :params => {:id => @chosen_customer.id }, class: " btn-sm btn-warning form-width" %>
        </div>
      </div>
    <% end %>
  </div><br>

  <span class="h3-grey">Followup</span><br>
  <div class="h4-black theme-text">
    <%= { "30" => "1 month", "60" => "2 months", "90" => "3 months", "120" => "4 months", "150" => "5 months", "180" => "6 months", "365" => "12 months" }[@chosen_customer.followup.to_s].presence || "—" %>
  </div>

    <div class="h3-grey theme-text"><br>
      Account Manager:
      <span class="h4-black theme-text"><%= @chosen_customer.user.name rescue "NA" %></span>
    </div>

  <br><br>


  <div class="">
    <!-- Add Customer Js working on 7-15-2023 -->
<div class="dropdown toggle_contact">
  <button class="btn btn-warning dropdown-toggle" type="button" id="dropdownContacts" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    + Contacts
  </button>
  <div class="dropdown-menu edit_form_contact hide" aria-labelledby="dropdownContacts">
    <div class="">
        <%= form_for(@contact) do |f| %>
        <div class="field">
          <%= f.label "Position" %>*
          <%= f.text_field :position, placeholder: "Owner", :class => "form-control input-lg ", :id => "name", required: false %>
        </div>
        <div class="field">
          <%= f.label "First Name" %>*
          <%= f.text_field :firstname, placeholder: "First Name", :class => "form-control input-lg ", :id => "name", required: true %>
        </div>

        <div class="field">
          <%= f.label "Last Name" %>
          <%= f.text_field :lastname, placeholder: "Last Name", :class => "form-control input-lg ", :id => "name" %>
        </div>
        <div class="field">
          <%= f.label "Phone" %>
          <%= f.text_field :phone, minlength: 10, maxlength: 10, placeholder: "10 Digit Phone Number", :class => "form-control input-lg ", :id => "name", required: false %>
        </div>
        <div class="field">
          <%= f.label "Email" %>
          <%= f.text_field :email, placeholder: "Email", :class => "form-control input-lg ", :id => "name", required: false %>
        </div>

        <%= f.hidden_field :customer_id, :value => @chosen_customer.id %>
        <%= hidden_field_tag(:subaction, @chosen_customer.id) %>

        <%= f.submit "Save", :name => nil, :params => {:id => @chosen_customer.id}, class: "btn btn-md btn-warning form-width round" %>

      <% end %>
    </div><br>
  </div>

</div>

<div class="flex-box-left-off">
  <div class="flex-box-horizontal-limit-off">
    <% if @indiv_contacts.any? %>
      <% @indiv_contacts.each do |c| %>

