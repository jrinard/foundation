                <%= link_to image_tag("icon-delete-black.png", alt: "Delete", class: "icon-edit icon-edit-customer theme-icon"), c, class: "btn-default btn-clean", data: { turbo_method: "delete", turbo_confirm: "Are you sure you want to delete the contact?" }, params: { subaction: @chosen_customer.id, l: @chosen_customer.letter, view_notes: "view_notes" } %>
              </div>
