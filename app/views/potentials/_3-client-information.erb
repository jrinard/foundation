              <%#= f.submit "Save", :name => nil, :params => {:id => @chosen_customer.id }, class: " btn-sm btn-warning form-width pull-right" %>
            <%# </div> %>
          <%# end %>
        <%# </div> %>
        <div class="contact-copy-shift">
      <img class="nav-icon-size-tiniest" data-controller="copy-phone" data-action="click->copy-phone#copyPhone" data-copy-phone-text="<%= c.phone %>" src="/assets/copy_icon.png">
      <br>
      <img class="nav-icon-size-tiniest" data-controller="copy-email" data-action="click->copy-email#copyEmail" data-copy-email-text="<%= c.email %>" src="/assets/copy_icon.png">
      <br>
 </div>
      </div>
    <% end %>
  <% else %>
    <h5 class="p">No Contacts</h5><br>
  <% end %>
</div>
</div>


<br>

<% linked_discovery = @chosen_customer&.linked_discovery_business %>
<% if discovery_enabled? && linked_discovery.present? %>
  <div class="discovery-prospect-score-entry">
    <%= render "discovery/score_card_modal", business: linked_discovery %>
  </div>
  <br>
<% end %>

<!-- Offerings V2 -->
<% if SiteSetting.customer_offerings_section_visible? %>
<% if @customer_offerings_find.any? %>
        <div class="dropdown toggle_contact" dataID="service-agreement-v2-pot">
        <button class="btn btn-default btn-wide-full-header-center dropdown-toggle theme-back theme-text" type="button" id="dropdownThreeDots" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
         <strong>Products/Services</strong> <%= image_tag("icon-filter.png", alt: "like", class: "nav-icon-size-dropdown pl-10 theme-icon") %>
        </button>

  <div class="dropdown-menu edit_form_contact hide" aria-labelledby="dropdownThreeDots">
      <%= render "shared/customer_offering_slots", cs: @cs, customer: @chosen_customer %>
  </div>


    <% if @cs.present? %>
      <% Offering.slot_numbers.each do |n| %>
        <% next unless @cs.slot_active?(n) && @cs.slot_configured?(n) %>
        <span class="btn btn-md btn-warning btn-wide-full">
          <%= @cs.slot_category(n) %> <%= @cs.slot_name(n) %>
        </span>
      <% end %>

      <% if Offering.slot_numbers.none? { |n| @cs.slot_configured?(n) } %>
        <p>The products/services template needs setup in settings before you can assign any.</p>
      <% end %>
    <% end %>

    <br>

  <% else %>
  <%= link_to 'Add Products/Services', { :add_offerings => "add_offerings", :id => @chosen_customer.id }, :class => "btn btn-md btn-warning" %>
<% end %>


  </div><br>
<% end %>
       


           <div class="service-card-off">
         <br>
         <%= link_to 'Invoices', invoices_modal_home_path(@chosen_customer.id), class: "btn btn-md btn-default theme-text", data: { turbo_frame: "modal" } %>

         <% if current_user.admin? || current_user.superadmin? %>
