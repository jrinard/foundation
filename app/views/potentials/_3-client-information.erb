            <%#= link_to "X", c, :params => {:subaction => @chosen_customer.id}, :class => "btn-default pull-right btn-clean", :id => "delete-test", :data => {:confirm => "Are you sure you want to delete the contact?",:method => "delete"} %>
            <%# Turbo with Confirmation %>
            <%#= link_to "X", c, class: "btn-default pull-right btn-clean", data: { turbo_method: "delete", turbo_confirm: "Are you sure you want to delete the contact?" }, params: { subaction: @chosen_customer.id } %>

