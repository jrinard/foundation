<%= button_to local_assigns.fetch(:label, "Unarchive"),
      unarchive_customer_path(customer),
      method: :post,
      class: "btn btn-default theme-text",
      form: {
        class: "prospect-archive-form",
        data: {
          turbo: false,
          turbo_confirm: local_assigns.fetch(
