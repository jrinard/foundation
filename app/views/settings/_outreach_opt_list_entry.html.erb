<li class="settings-outreach-opt-list-item theme-text">
  <% if entry.customer.present? && entry.path.present? %>
    <%= link_to entry.path, class: "settings-outreach-opt-pill" do %>
      <span class="settings-outreach-opt-pill-name"><%= entry.customer.name %></span>
      <span class="settings-outreach-opt-pill-id">#<%= entry.customer_id %></span>
    <% end %>
  <% else %>
    <span class="settings-outreach-opt-pill settings-outreach-opt-pill--static">
      <span class="settings-outreach-opt-pill-name"><%= entry.phone_display %></span>
    </span>
  <% end %>

  <% if entry.phone_display.present? && entry.customer.present? %>
    <span class="settings-outreach-opt-list-meta outreach-muted"><%= entry.phone_display %></span>
  <% end %>

  <% if entry.opted_at.present? %>
    <span class="settings-outreach-opt-list-meta outreach-muted"><%= entry.opted_at.strftime("%b %d, %Y") %></span>
  <% elsif entry.note.present? && entry.customer.blank? %>
    <span class="settings-outreach-opt-list-meta outreach-muted"><%= entry.note %></span>
  <% end %>
</li>
