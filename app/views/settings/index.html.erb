<div class="flex-box2">
  <div class="desk-marg">
    <div class="col-xs-8 center">
      <div class="customer-note-report support-white-card-theme">
        <h1 class="settings-title">Settings</h1>
        <p class="theme-text settings-org-context">Organization: <strong><%= current_organization.name %></strong></p>
        <div class="settings-menu">
          <div class="settings-buttons">
            <% offerings_button_class = params[:offerings] == 'offerings' ? 'btn btn-xl btn-default settings-menu-button active' : 'btn btn-xl btn-default settings-menu-button' %>
            <%= link_to "Products/Services", { :offerings => "offerings" }, class: offerings_button_class %>

            <% transfer_button_class = params[:transfer] == 'transfer' ? 'btn btn-xl btn-default settings-menu-button active' : 'btn btn-xl btn-default settings-menu-button' %>
            <%= link_to "Transfer", { :transfer => "transfer" }, class: transfer_button_class %>

            <% if org_admin? %>
            <% features_button_class = params[:features] == 'features' ? 'btn btn-xl btn-default settings-menu-button active' : 'btn btn-xl btn-default settings-menu-button' %>
            <%= link_to "Features", { features: "features" }, class: features_button_class %>
            <% end %>

            <% if org_admin? && discovery_enabled? %>
            <% discovery_button_class = params[:discovery] == 'discovery' ? 'btn btn-xl btn-default settings-menu-button active' : 'btn btn-xl btn-default settings-menu-button' %>
            <%= link_to "Discovery", { :discovery => "discovery" }, class: discovery_button_class %>
            <% end %>

        <% if org_admin? && quickbooks_enabled_for_org? %>
            <% qb_button_class = params[:qb] == 'qb' ? 'btn btn-xl btn-default settings-menu-button active' : 'btn btn-xl btn-default settings-menu-button' %>
            <%= link_to "Quickbooks", { :qb => "qb" }, class: qb_button_class %>
          <% end %>
        </div>
        </div>
    


        <% if params[:offerings] %>  
          <%= render 'offerings', offering: @main_offering %>
        <% end %>
         <% if params[:transfer] %>  
          <%= render 'transfer', account_managers: @accountManagers, customers: @allCustomers %>
        <% end %>
         <% if params[:features] && org_admin? %>
          <%= render 'modules' %>
        <% end %>
         <% if params[:discovery] && org_admin? && discovery_enabled? %>
          <%= render 'discovery' %>
        <% end %>
         <% if params[:qb] && org_admin? && quickbooks_enabled_for_org? %>
          <%= render 'qb' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
<!-- flex-end -->
