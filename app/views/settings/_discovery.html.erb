<div class="row">
  <br>
  <div class="h3-black theme-text">Discovery — <%= current_organization.name %></div>
  <br>

  <% wa_sos_source = DiscoverySource.ensure_wa_sos!(current_organization) %>
  <% data_axel_source = DiscoverySource.ensure_data_axel!(current_organization) %>

  <div class="qb-form-cont lead-card-dark theme-text discovery-gem-sources-card">
    <h3 class="h4-black theme-text discovery-gem-sources-title">Data Gem Sources</h3>

    <%= form_with url: update_discovery_settings_path, method: :patch, local: true, class: "discovery-gem-sources-form" do %>
      <div class="discovery-gem-sources-grid">
        <label class="org-admin-check discovery-gem-source-option">
          <%= hidden_field_tag "discovery_sources[wa_sos][enabled]", "0" %>
          <%= check_box_tag "discovery_sources[wa_sos][enabled]", "1", wa_sos_source.enabled?, class: "discovery-gem-source-checkbox" %>
          <span class="discovery-gem-source-name theme-text">River Gems</span>
          <span class="discovery-gem-source-subtext theme-text"><%= Discovery::GemSources.subtext_for(DiscoveryBusiness::SOURCE_WA_SOS) %></span>
        </label>

        <label class="org-admin-check discovery-gem-source-option">
          <%= hidden_field_tag "discovery_sources[data_axel][enabled]", "0" %>
          <%= check_box_tag "discovery_sources[data_axel][enabled]", "1", data_axel_source.enabled?, class: "discovery-gem-source-checkbox" %>
          <span class="discovery-gem-source-name theme-text">Mountain Gems</span>
          <span class="discovery-gem-source-subtext theme-text"><%= Discovery::GemSources.subtext_for(DiscoveryBusiness::SOURCE_DATA_AXEL) %></span>
        </label>
      </div>

      <%= submit_tag "Save", class: "btn btn-default theme-text discovery-gem-sources-save" %>
    <% end %>
  </div>
</div>
