<div class="row">
  <br>
  <div class="h3-black theme-text">Features — <%= current_organization.name %></div>
  <br>

  <p class="theme-text">
    Each feature controls its menu item and related tools. When a feature is off, org users cannot reach it from the nav or by URL.
  </p>

  <%= form_with model: current_organization, url: update_organization_modules_path, method: :patch, local: true do |f| %>
    <div class="qb-form-cont lead-card-dark theme-text">
      <label class="org-admin-check">
        <%= f.check_box :discovery_enabled %>
        Discovery — automated business prospecting
      </label>

      <label class="org-admin-check">
        <%= f.check_box :potentials_enabled %>
        Prospects — pre-pipeline list
      </label>

      <label class="org-admin-check">
        <%= f.check_box :outreach_enabled %>
        Outreach — campaign pursuit and plan steps
      </label>

      <label class="org-admin-check">
        <%= f.check_box :leads_enabled %>
        Leads — kanban board and New Lead
      </label>

      <label class="org-admin-check">
        <%= f.check_box :current_clients_enabled %>
        Current Clients — active customer directory
      </label>

      <label class="org-admin-check">
        <%= f.check_box :archived_enabled %>
        Archived — inactive customers
      </label>

      <label class="org-admin-check">
        <%= f.check_box :activity_enabled %>
        Activity — account manager activity feed
      </label>

      <br>
      <%= f.submit "Save features", class: "btn btn-xl btn-default settings-menu-button" %>
    </div>
  <% end %>

  <br>
  <p class="theme-text help-block">
    QuickBooks and Operations are configured on the Organizations tab (superadmin only).
    When QuickBooks is enabled, its settings appear under the Quickbooks tab above.
    When Discovery is enabled, source settings appear under the Discovery tab above.
  </p>
</div>
